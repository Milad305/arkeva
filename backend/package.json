{
  "name": "@projeyar/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "بک‌اند پروژه‌یار — NestJS + MikroORM (docs/backend/)",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "prebuild": "pnpm --filter @projeyar/shared run build",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:bootstrap": "node dist/scripts/db-bootstrap.js",
    "db:migrate": "node dist/main.js migrate",
    "db:seed": "node dist/scripts/seed.js",
    "backup:decrypt": "node dist/scripts/backup-decrypt.js",
    "openapi:emit": "node dist/scripts/openapi-emit.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@aws-sdk/s3-request-presigner": "3.1167.0",
    "@fontsource/vazirmatn": "5.3.0",
    "@mikro-orm/core": "7.2.8",
    "@mikro-orm/migrations": "7.2.8",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.8",
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@projeyar/shared": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "exifr": "7.1.3",
    "helmet": "8.3.0",
    "kysely": "0.29.8",
    "nestjs-cls": "7.0.2",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "puppeteer-core": "25.16.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.2",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
