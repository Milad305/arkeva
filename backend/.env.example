# پیکربندی بک‌اند پروژه‌یار (docs/backend/10-operations.md ۲)
# این فایل را به .env کپی کنید و مقدارها را پر کنید. هیچ رازی در مخزن نیست.

# ── اپ ──
NODE_ENV=development
# api | worker | all | migrate — در توسعه all
APP_ROLE=all
PORT=3000
# مبدأهای مجاز CORS، با ویرگول. با پراکسی Vite لازم نیست.
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=true

# ── پایگاه داده (05 ۴.۳) ──
# نقش اپ: مالک هیچ جدولی نیست و RLS را دور نمی‌زند
DB_URL=postgres://projeyar_app:CHANGE_ME_APP@localhost:5432/projeyar
# نقش مالک: فقط migration
DB_MIGRATION_URL=postgres://projeyar_owner:CHANGE_ME_OWNER@localhost:5432/projeyar
# فقط برای ساخت نقش‌ها و پایگاه داده (db:bootstrap) و ساخت پایگاه دادهٔ موقت تست
DB_ADMIN_URL=postgres://postgres:CHANGE_ME_POSTGRES@localhost:5432/postgres
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# فقط توسعه: چاپ پرس‌وجوها
DB_DEBUG=false

# ── احراز هویت (07 ۲) ──
# کلیدهای امضای JWT: kid:secret با ویرگول؛ اولی امضا می‌کند، بقیه فقط بررسی (چرخش بی‌قطع). دست‌کم ۳۲ نویسه.
JWT_KEYS=k1:CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TTL_SEC=600
REFRESH_IDLE_TTL_MIN=30
REFRESH_ABSOLUTE_TTL_HOURS=12
COOKIE_SECURE=true
OTP_TTL_SEC=300
OTP_RESEND_SEC=60
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MIN=15
# فقط توسعه و فقط با SMS_PROVIDER=console: کد ثابت ورود دومرحله‌ای. در production برنامه بالا نمی‌آید.
OTP_DEV_CODE=123456

# ── پیام ──
# console: کد را در لاگ می‌نویسد (توسعه)
SMS_PROVIDER=console

# ── اپ کارگاه (F08 ۵.۳) ──
# حداقل نسخهٔ اپ؛ کمتر ← ۴۲۶ APP_VERSION_UNSUPPORTED. خالی ← بی بررسی.
# APP_MIN_VERSION=1.0.0

# ── صف کار (pg-boss، docs/backend/08) ──
# فاصلهٔ poll کارگرها به ثانیه (کمینه 0.5) و سقف اتصال‌های pg-boss
JOB_POLL_INTERVAL_SEC=2
JOB_POOL_MAX=4

# ── ذخیره‌سازی فایل (F20 ۷) ──
# disk: پوشهٔ محلی (توسعه، تست، نصب تک‌سرور)؛ s3: S3 یا MinIO. در production تعیینش اجباری است.
STORAGE_DRIVER=disk
# پیش‌فرض backend/var/storage
# STORAGE_DISK_ROOT=
# عمر لینک امضاشده به ثانیه (پیش‌فرض ۵ دقیقه)
# STORAGE_LINK_TTL_SEC=300

# پشتیبان پروژه (F20 ۱۲): kid:base64 با ۳۲ بایت؛ در production الزامی. کلید تازه را اول بگذارید و قدیمی را برای
# خواندن نسخه‌های پیشین نگه دارید. ساخت: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# BACKUP_KEYS=k1:
# فقط با STORAGE_DRIVER=s3 (MinIO: S3_ENDPOINT=http://localhost:9000 و S3_FORCE_PATH_STYLE=true)
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ── مشاهده‌پذیری ──
LOG_LEVEL=info
LOG_PRETTY=true

# ── تست یکپارچگی ──
# هر فایل تست یک پایگاه دادهٔ موقت روی همین سرور می‌سازد و پاک می‌کند
TEST_DB_ADMIN_URL=postgres://postgres:CHANGE_ME_POSTGRES@localhost:5432/postgres

# گزارش مدیریتی (F18): مسیر Chromium/Chrome برای ساخت PDF؛ خالی ← جای‌های رایج ویندوز و لینوکس
# REPORT_BROWSER_PATH=
# نشانی عمومی API برای لینک امضاشدهٔ ایمیل گیرندهٔ بیرونی گزارش
# PUBLIC_BASE_URL=http://localhost:3000
