# کاربر مدیر پستگرس (superuser). کپی به /opt/arkeva/admin/postgres.env با chmod 600.
# فقط خود پستگرس و فرمان یک‌بارهٔ bootstrap آن را می‌بینند؛ برنامه هرگز با این کاربر وصل نمی‌شود.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_DB=postgres
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C.UTF-8
