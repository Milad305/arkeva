# پیکربندی بک‌اند روی سرور دمو (deploy/README.md). کپی به /opt/arkeva/backend/backend.env با chmod 600.
# هر CHANGE_ME را با مقدار تصادفی عوض کنید (فرمان‌های ساخت در README). شرح کامل هر متغیر: backend/.env.example
#
# دمو: NODE_ENV=development تا دادهٔ نمونه (seed)، کد ثابت ورود و کوکی بی Secure روی HTTP مجاز باشد.
# این حالت برای دادهٔ واقعی نیست؛ رفتن به production دامنه، HTTPS و راه ساخت اولین سازمان می‌خواهد.

NODE_ENV=development
APP_ROLE=all
PORT=3000
# پنل و API هم‌مبدأ‌اند (nginx)؛ CORS لازم نیست
CORS_ORIGINS=
# یک پراکسی (nginx) جلوی برنامه
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=false

# ── پایگاه داده: دو کاربر جدا، هیچ‌کدام postgres نیست (05 ۴.۳) ──
DB_URL=postgres://projeyar_app:CHANGE_ME_APP@postgres:5432/projeyar
DB_MIGRATION_URL=postgres://projeyar_owner:CHANGE_ME_OWNER@postgres:5432/projeyar
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_DEBUG=false

# ── احراز هویت ──
JWT_KEYS=k1:CHANGE_ME_JWT_AT_LEAST_32_CHARS
# روی HTTP مرورگر کوکی Secure را نگه نمی‌دارد؛ با HTTPS باید true شود
COOKIE_SECURE=false
SMS_PROVIDER=console
# برای ارسال واقعی پیامک OTP با sms.ir: خط بالا را SMS_PROVIDER=sms.ir بگذارید، OTP_DEV_CODE را حذف کنید و مقادیر زیر را پر کنید:
# OTP_SMS_KEY=
# OTP_TEMPLATE_ID=
# OTP_TEMPLATE_PARAM=Code
# کد ثابت ورود دمو. هر کس رمز کاربران نمونه را بداند وارد می‌شود: دادهٔ واقعی وارد نکنید.
# برای بستن: این خط را حذف کنید؛ کد از لاگ خوانده می‌شود (docker compose logs backend | grep OTP).
OTP_DEV_CODE=123456

# ── صف ──
JOB_POLL_INTERVAL_SEC=2
JOB_POOL_MAX=2

# ── فایل ──
STORAGE_DRIVER=disk
STORAGE_DISK_ROOT=/data/storage
BACKUP_KEYS=k1:CHANGE_ME_BASE64_32_BYTES

# ── لاگ: pino-pretty در image نیست؛ true برنامه را بالا نمی‌آورد ──
LOG_LEVEL=info
LOG_PRETTY=false

PUBLIC_BASE_URL=http://45.149.79.158
